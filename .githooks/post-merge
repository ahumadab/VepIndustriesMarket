#!/bin/sh
# After `git pull`: delete local branches whose remote branch is gone (GitHub deletes it when the PR is merged).
# -D because PRs are squash-merged, so git does not see the branch as merged.
git fetch --prune --quiet
git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | while read -r branch track; do
  if [ "$track" = "[gone]" ] && [ "$branch" != "$(git branch --show-current)" ]; then
    git branch -D "$branch"
  fi
done
